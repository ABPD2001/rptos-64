ENTRY(init)
SECTIONS {
    . = 0x8000;
    .init:{
        ALIGN(4)
        *(.init)
    }
    .cores_info:{
        ALIGN(8)
        __core_stack_table__=.;
        *(.cores_info)
    }
    .vectors:{
        ALIGN(32)
        __vector_table__=.;
        *(.vectors)
    }
    .vector_table_handlers:{
        ALIGN(4)
        *(vector_table_handlers)
    }
    .bss:{
        ALIGN(16)
        __bss_start__=.;
        *(.bss)
        *(COMMON)
        __bss_end__=.;
    }
    .text:{
        ALIGN(4)
        *(.text)
    }
    .sync_same_el_table:{
        __sync_same_el_table_start__=.;
        ALIGN(4)
        *(.sync_same_el_table)
    }
}